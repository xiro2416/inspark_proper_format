import triton
from normal_tf32_runtime_kernel import online_branch_stats
@triton.jit
def normal_tile_aot(Q,K,PQ,E,Mask,V,T,O):
    online_branch_stats(Q,K,PQ,E,Mask,V,O,O,T,False,64,32,'tf32',0)
@triton.jit
def normal_stats_write_aot(Q,K,PQ,E,Mask,V,T,O,Stats):
    online_branch_stats(Q,K,PQ,E,Mask,V,O,Stats,T,False,64,32,'tf32',1)
@triton.jit
def normal_stats_read_aot(Q,K,PQ,E,Mask,V,Stats,T,O):
    online_branch_stats(Q,K,PQ,E,Mask,V,O,Stats,T,False,64,32,'tf32',2)
